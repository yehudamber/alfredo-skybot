    "@types/node": "^22.9.3",
    "eslint": "^10.9.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@atproto/api": "^0.13.18",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true
